# Copy this file to `.env` (`cp .env.template .env`). The eval config loads
# every var here into `process.env` — a var set on the command line wins.
# Only the evals read it; `pnpm test` needs no key.

# Google Gemini — the only provider the evals drive. Without it the LLM
# scenarios skip and only the hermetic context-cost measurement runs.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=fake-gemini-api-key

# --- Eval knobs (all optional; defaults shown) ---------------------------

# Transport family: `text` (request/response) or `live` (streaming socket —
# the family the context optimizations exist for).
# A2UI_EVAL_TRANSPORT=text

# Model override (default: gemini-3.5-flash for text,
# gemini-3.1-flash-live-preview for live).
# A2UI_EVAL_MODEL=gemini-3.5-flash

# Experiment arms to run, comma-separated: baseline, optimized, bare.
# A2UI_EVAL_PROFILES=baseline,optimized,bare

# Quota survival: gap between conversation turns, and 429 retries. Lower the
# gap for a quick single-scenario run; keep it high for a full matrix.
# A2UI_EVAL_TURN_GAP_MS=30000
# A2UI_EVAL_MAX_RETRIES=1

# Task rows on the static fixture — surface density, the variable the
# optimizations exist for. Assertions hold at any count >= 6.
# A2UI_EVAL_TODO_COUNT=6
