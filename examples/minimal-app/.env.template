# Copy this file to `.env` (`cp .env.template .env`) and replace the
# placeholders for the providers you want to try. The app's model picker
# enables an option only when its provider's key is configured — a value
# left as a `fake-…` placeholder (or removed entirely) keeps that
# provider disabled.

# Google Gemini — enables "Gemini Live" (voice) and "Gemini 3.5 Flash" (text).
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=fake-gemini-api-key

# Anthropic — enables "Claude" (text). https://console.anthropic.com/
ANTHROPIC_API_KEY=fake-anthropic-api-key

# OpenAI — enables "GPT" (text) and "OpenAI Realtime" (voice).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=fake-openai-api-key

# Deepgram — enables "Deepgram Voice Agent" (voice).
# Free $200 signup credits, no card: https://console.deepgram.com/
DEEPGRAM_API_KEY=fake-deepgram-api-key

# Hume — enables "Hume EVI" (voice). Needs BOTH keys (the pair feeds the
# OAuth client-credentials grant). Free monthly credits:
# https://platform.hume.ai/settings/keys
HUME_API_KEY=fake-hume-api-key
HUME_SECRET_KEY=fake-hume-secret-key
